#!/usr/bin/python3 -I
"""`incident-payload` on a Run's PATH: the package's module, run by the image's own Python.

The package is copied to /app rather than installed, so this puts /app on the path and
runs `grafana_jsm_sandbox.incident_payload`. `-I` keeps out anything a Run's environment
or working directory could add to that path. ADR 0003's 2026-10-01 amendment says why a
Run may run it.
"""

import sys

sys.path.insert(0, "/app")

from grafana_jsm_sandbox.incident_payload import main

raise SystemExit(main())
