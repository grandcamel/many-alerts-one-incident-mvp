# The demo's one configuration. Copy it, fill in the values in the first part,
# and never commit the copy:
#
#     cp .env.example .env
#
# Git ignores .env and the build context refuses it, so no credential is baked
# into the image; compose hands it to the demo container at `docker compose up`.
# The laptop helpers (configure, doctor, verify, reset, replay and the
# end-to-end check) read this same file, never your shell's own jira-as
# settings. After changing it, recreate the container with
# `docker compose up -d demo`: a restart keeps the values it was created with.
# `python3 -m grafana_jsm_sandbox.doctor` checks it.

# --- Yours to fill in -------------------------------------------------------

# The Jira site and the account the demo acts as. The account needs a Jira
# Service Management agent licence and a role on the demo's project
# (docs/admin-requests.md). With a classic API token, from
# https://id.atlassian.com/manage-profile/security/api-tokens, the site URL is
# the bare address, https://<your-site>.atlassian.net, with no path. With a
# service account's scoped token it is the API gateway,
# https://api.atlassian.com/ex/jira/<cloudId>, where <cloudId> is the "cloudId"
# that https://<your-site>.atlassian.net/_edge/tenant_info shows. A token
# expires; note the date you chose.
#
# In the container the token lives only in the Receiver and the Forwarder it
# owns: a Run gets a per-Run sentinel in its place (ADR 0002).
JIRA_SITE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.invalid
JIRA_API_TOKEN=paste-your-atlassian-api-token-here

# What a Run authenticates to Claude with: exactly one of these two. A work API
# key (sk-ant-api...), from your organisation's Anthropic Console, is the usual
# one. A Claude Code OAuth token, the output of `claude setup-token` run where
# Claude Code is logged in, choosing your organisation on the consent screen,
# still works: set it instead and leave ANTHROPIC_API_KEY unset. Whichever is
# set is the one credential a Run really holds, under this same name, and the
# demo says so out loud. `doctor` refuses none, both, or one in the other's place.
# Uncomment and fill exactly one; leave the other empty and commented.
# ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=

# Which take this is: 1 to 32 of a-z, 0-9 and hyphens, starting with a letter
# and with no hyphen before a digit (jira-as reads rehearsal-1 as an issue key
# and refuses the search; rehearsal1 is fine). Every Incident a Run
# creates carries the label ses-<id>, and a Run matches only open Incidents
# with this take's label, so a rehearsal's leftovers never match the real
# demo's alerts. Change it before each take, then `docker compose up -d demo`.
DEMO_SESSION_ID=rehearsal1

# The key of the Jira Service Management project the demo writes to: one a Jira
# admin created for it from the IT service management template, and nobody
# else's (docs/admin-requests.md#jira-admin-create-project). There is no
# default: the Receiver refuses to start until this names your project, and
# each Run's jira-as refuses a call that names another.
DEMO_PROJECT_KEY=

# --- Written by configure ---------------------------------------------------

# The project's own custom field ids (customfield_<n>) and its Incidents queue.
# Leave them to `python3 -m grafana_jsm_sandbox.configure --write`, which reads
# them off the project's create screen and service desk. The Receiver renders
# the field ids into the Run's Skill at every start. An empty field id means
# the project lacks the field, or it could not be pinned down, and a Run leaves
# the field off. The queue URL is what the runbook projects and verify names.
DEMO_SEVERITY_FIELD=
DEMO_URGENCY_FIELD=
DEMO_SOURCE_FIELD=
DEMO_MAJOR_INCIDENT_FIELD=
DEMO_QUEUE_URL=

# `configure --write` fills these status roles from the project's workflow.
# An empty DEMO_STATUS_CLOSED means this workflow has no close step.
# DEMO_STATUS_OPEN=Open
# DEMO_STATUS_IN_PROGRESS=Work in progress
# DEMO_STATUS_DONE=Completed
# DEMO_STATUS_CLOSED=Closed

# --- Optional; uncomment to override ---------------------------------------

# Where compose publishes Grafana and the Receiver on this laptop: loopback
# only, and another port when 3000 or 8080 is taken. The containers' own ports
# and Grafana's contact point stay as they are. The laptop helpers follow them.
# BIND_ADDRESS=127.0.0.1
# GRAFANA_HOST_PORT=3000
# RECEIVER_HOST_PORT=8080

# The model every Run asks for: an alias Claude Code knows or a model's full
# name. The organisation or seat behind the model credential must be allowed
# to use it; the Receiver logs the one it will use at startup.
# RUN_MODEL=claude-opus-5

# The most one Run may spend, in dollars (Claude Code's --max-budget-usd,
# checked against its own estimate of spend, not a billing limit). Unset, a Run
# has no cap but its timeout.
# RUN_BUDGET_USD=2

# Seconds before a stuck Run is killed. verify waits this plus a minute for
# each Run's stage.
# RUN_TIMEOUT=300

# The Grafana stack's image, pinned in docker-compose.yml by tag and digest. Set
# this only to pull the same image from somewhere else, such as a mirror.
# LGTM_IMAGE=grafana/otel-lgtm:0.33.0@sha256:475319e883b66594d1a2f22ef168c2459802bb94548e6f25d9782bd5f5c19a3a

# --- Inside the container; leave these alone --------------------------------

# Where the Receiver listens and keeps its files inside the container. The image
# already sets the two directories, and Grafana's contact point and the
# healthcheck expect port 8080, so move the laptop's side with
# RECEIVER_HOST_PORT above instead.
# RECEIVER_HOST=0.0.0.0
# RECEIVER_PORT=8080
# RUNS_DIRECTORY=/app/runs
# SKILL_DIRECTORY=/app/skill
